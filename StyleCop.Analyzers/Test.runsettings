<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- The tests allocate heavily on every core. .NET takes server GC from COMPlus_gcServer, .NET Framework only from
         COMPlus_BuildFlavor; the other names work on both. -->
    <EnvironmentVariables>
      <COMPlus_gcServer>1</COMPlus_gcServer>
      <COMPlus_BuildFlavor>SVR</COMPlus_BuildFlavor>
      <COMPlus_gcConcurrent>0</COMPlus_gcConcurrent>
      <COMPlus_TieredCompilation>0</COMPlus_TieredCompilation>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
