<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <PackageId>StyleCop.Analyzers.NewIdRequiredDueToNuGetBug</PackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!--
      Embed the portable PDB in the shipped assembly. Analyzers are loaded by the compiler and the IDE, not by the
      user's application, so a separate symbol package is rarely found. With the PDB inside the DLL, stack traces
      from analyzer hosts include file and line information, and a debugger finds the symbols without a symbol
      server. Debug builds keep a separate portable PDB (see Directory.Build.props), which code coverage uses.
    -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <CodeAnalysisRuleSet>..\StyleCop.Analyzers.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\build\keys\StyleCopAnalyzers.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)\Lightup\.generated</CompilerGeneratedFilesOutputPath>
    <!-- Non-default Roslyn flavors may build in parallel with the default one, so they must not share the folder. -->
    <CompilerGeneratedFilesOutputPath Condition="'$(IsDefaultRoslynVersion)' != 'true'">$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisVersion)" />
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Lightup\Syntax.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The .generated file is excluded by default, but we want to show the items in Solution Explorer so we included it as None -->
    <None Include="Lightup\.generated\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\StyleCop.Analyzers.CodeGeneration\StyleCop.Analyzers.CodeGeneration.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>