<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard1.1</TargetFramework>
    <!-- netstandard1.1 keeps 1.x loadable by old Visual Studio and Roslyn hosts; the SDK warns about it (NETSDK1215). -->
    <CheckNotRecommendedTargetFramework>false</CheckNotRecommendedTargetFramework>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <PackageTargetFallback>portable-net45+win8</PackageTargetFallback>

    <!--
      netstandard1.1 is intentional: it keeps the analyzers loadable by Roslyn 1.2+ hosts (Visual Studio 2015 Update 2
      and later). Silence the .NET SDK's NETSDK1215 "not recommended" warning for that deliberate choice.
    -->
    <CheckNotRecommendedTargetFramework>false</CheckNotRecommendedTargetFramework>
    <RootNamespace>StyleCop.Analyzers</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>

    <NuspecFile>StyleCop.Analyzers.nuspec</NuspecFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- This package intentionally uses SemVer 2. -->
    <NoWarn>$(NoWarn),NU5105</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <CodeAnalysisRuleSet>..\StyleCop.Analyzers.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\build\keys\StyleCopAnalyzers.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="1.2.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StyleCop.Analyzers\StyleCop.Analyzers.csproj" />
  </ItemGroup>

  <Target Name="SetNuspecProperties" BeforeTargets="GenerateNuspec" DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <NuspecProperties>id=StyleCopNext.Analyzers;configuration=$(Configuration);version=$(PackageVersion);commit=$(SourceRevisionId);tag=v$(PackageVersion)</NuspecProperties>
    </PropertyGroup>
  </Target>

</Project>