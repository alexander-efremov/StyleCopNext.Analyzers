<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <RootNamespace>StyleCop.Analyzers</RootNamespace>
    <!-- Only the default flavor packs. It builds the other flavors itself (see BuildRoslynFlavors). -->
    <GeneratePackageOnBuild Condition="'$(IsDefaultRoslynVersion)' == 'true'">true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>

    <NuspecFile>StyleCop.Analyzers.nuspec</NuspecFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- This package intentionally uses SemVer 2. -->
    <NoWarn>$(NoWarn),NU5105</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <CodeAnalysisRuleSet>..\StyleCop.Analyzers.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\build\keys\StyleCopAnalyzers.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(MicrosoftCodeAnalysisVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StyleCop.Analyzers\StyleCop.Analyzers.csproj" />
  </ItemGroup>

  <!--
    The package carries one build per supported Roslyn version. Before the package is generated, build the other
    flavors of this project (and of the analyzer project it references) with their own restore, obj and bin folders.
  -->
  <Target Name="BuildRoslynFlavors" BeforeTargets="GenerateNuspec" Condition="'$(IsDefaultRoslynVersion)' == 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Restore"
             Properties="RoslynVersion=5.0;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="RoslynVersion=5.0;Configuration=$(Configuration)" />
  </Target>

  <Target Name="SetNuspecProperties" BeforeTargets="GenerateNuspec" DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <NuspecProperties>id=StyleCopNext.Analyzers;configuration=$(Configuration);version=$(PackageVersion);commit=$(SourceRevisionId);tag=v$(PackageVersion)</NuspecProperties>
    </PropertyGroup>
  </Target>

</Project>