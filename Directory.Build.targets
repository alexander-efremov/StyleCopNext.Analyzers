<?xml version="1.0" encoding="utf-8"?>
<Project>

  <ItemGroup>
    <None Include="$(MSBuildProjectFileDirectory)$(AssemblyOriginatorKeyFile)" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <RunSettingsFilePath Condition="'$(RunSettingsFilePath)' == ''">$(MSBuildThisFileDirectory)Test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

</Project>
