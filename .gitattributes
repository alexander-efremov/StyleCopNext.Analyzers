# Source code files
# The tests compare code in multi-line string literals with CRLF line endings, so C# files are CRLF everywhere.
*.cs text eol=crlf
*.vsixmanifest text
*.config text
*.resx text
*.vstemplate text
*.nuspec text
*.md text
*.txt text
*.ps1 text
LICENSE text

# Projects and solutions
*.sln text
*.csproj text

# Certainly binary files
*.png binary
*.ico binary
*.snk binary

# Checked-in output of the lightup and resx source generators (EmitCompilerGeneratedFiles in StyleCop.Analyzers.csproj).
# The generators write CRLF line endings, so check these files out with CRLF on every platform to match what a build
# writes. The repository stores them with LF like all other text files.
StyleCop.Analyzers/StyleCop.Analyzers/Lightup/.generated/** text eol=crlf
